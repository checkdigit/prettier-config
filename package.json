{
  "name": "@checkdigit/prettier-config",
  "version": "8.4.0",
  "private": false,
  "description": "Check Digit code formatting configuration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkdigit/prettier-config.git"
  },
  "license": "MIT",
  "author": "Check Digit, LLC",
  "type": "module",
  "main": "index.json",
  "files": [
    "index.json"
  ],
  "scripts": {
    "ci:compile": "",
    "ci:lint": "",
    "ci:style": "npm run prettier",
    "ci:test": "prettier --version | grep -qx '3.10.1' || { echo 'Error: invalid version'; exit 1; } && npm run ci:style",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "npm run ci:test"
  },
  "peerDependencies": {
    "@prettier/plugin-oxc": "0.2.4",
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
